{
  "manifest_version": 3,
  "name": "AirScroll AI Bridge",
  "version": "1.0.0",
  "description": "Lets the local AirScroll AI app scroll, like and pause Instagram Reels in this browser. Talks only to 127.0.0.1.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "alarms"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "emergency-stop": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "AirScroll emergency stop (disable control, turn camera off)"
    }
  },
  "action": { "default_title": "AirScroll AI: not connected" }
}
